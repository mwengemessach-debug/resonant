import { useEffect, useMemo, useRef, useState } from 'react';
import { Activity, ArrowRight, AudioLines, Check, ChevronDown, CircleDollarSign, CloudOff, Download, FileAudio, History, Info, LoaderCircle, Music2, Pause, Play, Plus, RotateCcw, Settings2, SlidersHorizontal, Sparkles, Upload, WandSparkles, X, Zap } from 'lucide-react';
import Waveform from './Waveform';
import { analyzeBuffer, bufferToWav, decodeAudio, makeReport, renderMaster } from './audio';

const initial={title:'Neon Afterglow',genre:'Alternative R&B, electronic soul',mood:'Intimate, nocturnal, hopeful',story:'Two people find their way back to each other on a rain-lit drive through the city.',instruments:'Warm Rhodes, sub bass, brushed electronic drums, glassy synth arpeggio, sparse guitar',tempo:96,rhythm:'Half-time pocket with subtle syncopation; chorus opens into a driving pulse',vocal:'Expressive alto, close and breathy in verses, layered harmonies in chorus',melody:'Conversational low verse; rising pre-chorus; concise, repeatable four-note hook',arrangement:'8-bar intro, verse, pre-chorus, wide chorus, short instrumental turn, verse 2, final double chorus, resolved outro',production:'Modern, warm and dimensional. Vocal forward, controlled sub, textured but uncluttered. Preserve transients.',lyrics:'[Verse 1]\nStreetlights running down the glass\nEvery green turns into past\nI kept your name beneath my tongue\nLike a song still half-unsung\n\n[Pre-Chorus]\nIf the city knows the way\nLet it lead me back today\n\n[Chorus]\nMeet me in the afterglow\nWhere the quiet colors show\nNo more running, take it slow\nMeet me in the afterglow',duration:180,referenceStrength:1.8,instrumental:false,negativeTags:'harsh distortion, novelty vocals'};
const fmt=t=>`${Math.floor(t/60)}:${String(Math.floor(t%60)).padStart(2,'0')}`;
async function api(url,options={}){const r=await fetch(url,options);const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`Request failed (${r.status})`);return j}

function Meter({score}){return <div className="meter"><i style={{width:`${Math.max(3,score)}%`}}/></div>}
function Field({label,hint,children,wide}){return <label className={`field ${wide?'wide':''}`}><span>{label}{hint&&<em>{hint}</em>}</span>{children}</label>}
function Range({label,value,min,max,step=1,onChange,suffix=''}){return <label className="range"><span>{label}<b>{value}{suffix}</b></span><input type="range" value={value} min={min} max={max} step={step} onChange={e=>onChange(Number(e.target.value))}/></label>}

export default function App(){
 const [brief,setBrief]=useState(initial),[config,setConfig]=useState(null),[brain,setBrain]=useState(null),[engines,setEngines]=useState([]),[ensemble,setEnsemble]=useState(null),[allowResearch,setAllowResearch]=useState(false),[view,setView]=useState('create'),[advanced,setAdvanced]=useState(false),[reference,setReference]=useState(null),[plan,setPlan]=useState(null),[job,setJob]=useState(null),[error,setError]=useState(''),[audioUrl,setAudioUrl]=useState(''),[buffer,setBuffer]=useState(null),[mastered,setMastered]=useState(null),[masterUrl,setMasterUrl]=useState(''),[analysis,setAnalysis]=useState(null),[busy,setBusy]=useState(false),[toast,setToast]=useState('');
 const [master,setMaster]=useState({low:0,presence:1.2,threshold:-14,ratio:2,gain:-1}); const poll=useRef(null); const canceled=useRef(false);
 useEffect(()=>{api('/api/config').then(setConfig).catch(e=>setConfig({connected:false,error:e.message}));api('/api/engines').then(setEngines).catch(()=>setEngines([]));api('/api/brain/status').then(setBrain).catch(()=>setBrain(null))},[]);
 useEffect(()=>()=>{clearTimeout(poll.current);if(masterUrl)URL.revokeObjectURL(masterUrl)},[masterUrl]);
 const update=(k,v)=>setBrief(x=>({...x,[k]:v}));
 const report=useMemo(()=>analysis?makeReport(analysis):[],[analysis]);
 const credits=(config?.credits?.num_credits||0)+(config?.credits?.num_credits_payg||0);

 async function buildPlan(){setBusy(true);setError('');try{const p=await api('/api/plan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...brief,referenceUploadId:reference?'pending':undefined})});setPlan(p);setToast('Production plan updated');setTimeout(()=>setToast(''),1800)}catch(e){setError(e.message)}finally{setBusy(false)}}
 async function generate(){
  if(!config?.verified){setError('Generation is locked until a server-side Treblo key is verified. You can still import and master audio.');return}
  setBusy(true);setError('');setJob({status:'PREPARING',progress:2});canceled.current=false;
  try{let referenceUploadId;if(reference){setJob({status:'UPLOADING_REFERENCE',progress:5});const f=new FormData();f.append('file',reference);const u=await api('/api/upload-reference',{method:'POST',body:f});referenceUploadId=u.audio_upload_id}
   if(canceled.current)return; const data=await api('/api/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...brief,referenceUploadId})});setPlan(data.plan);setJob({taskId:data.task_id,status:'RECEIVED',progress:4});watch(data.task_id);
  }catch(e){setError(e.message);setJob(null);setBusy(false)}
 }
 async function generateEnsemble(){
  const available=engines.filter(e=>e.available&&(allowResearch||e.commercial));if(!available.length){setError('Start at least one eligible local engine. ACE-Step is the recommended commercial-safe option.');return}
  setBusy(true);setError('');canceled.current=false;try{const s=await api('/api/ensemble/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...brief,allowNonCommercial:allowResearch})});setPlan(s.plan);setEnsemble(s);watchEnsemble(s.id)}catch(e){setBusy(false);setError(e.message)}
 }
 async function watchEnsemble(id){if(canceled.current)return;try{const s=await api(`/api/ensemble/status/${id}`);setEnsemble(s);if(!s.done){poll.current=setTimeout(()=>watchEnsemble(id),5000);return}const successful=s.candidates.filter(c=>c.localUrl);if(!successful.length)throw new Error('Every local model failed. Open the engine details and check each local service.');const ranked=[];for(const c of successful){try{const b=await decodeAudio(c.localUrl),m=analyzeBuffer(b);const score=Math.round(100-Math.min(45,m.clipping*120)-Math.min(20,Math.abs(m.peakDb+1)*3)-Math.min(15,Math.abs(m.crestDb-11)*1.5)-Math.max(0,m.stereoWidth-85)/3);ranked.push({...c,score,metrics:m,_buffer:b})}catch(e){ranked.push({...c,score:0,error:`Analysis failed: ${e.message}`})}}ranked.sort((a,b)=>b.score-a.score);const best=ranked[0];setEnsemble({...s,candidates:ranked.map(({_buffer,...x})=>x),bestEngine:best.engine});setAudioUrl(best.localUrl);setBuffer(best._buffer);setAnalysis(best.metrics);setMastered(null);setMasterUrl('');setBusy(false);setView('master');setToast(`${best.name} selected by measurable signal health; review all candidates before approval.`);setTimeout(()=>setToast(''),5000)}catch(e){setBusy(false);setError(e.message)}}
 async function watch(id){if(canceled.current)return;try{const s=await api(`/api/status/${id}`);setJob(x=>({...x,...s,taskId:id}));if(s.status==='FAILURE')throw new Error('Treblo could not generate this track. Credits should not be deducted; retry when ready.');if(s.status==='SUCCESS'){const result=await api(`/api/result/${id}`);const remote=result.song_paths?.[0];if(!remote)throw new Error('Generation completed without an audio URL.');let final=remote;try{const p=await api('/api/persist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:remote})});final=p.url}catch{}setAudioUrl(final);await loadAudio(final);setJob(x=>({...x,status:'SUCCESS',progress:100,result}));setBusy(false);setView('master');saveProject(id,final,result);return}poll.current=setTimeout(()=>watch(id),4000)}catch(e){setError(e.message);setBusy(false);setJob(x=>x?({...x,status:'FAILURE'}):null)}}
 function cancel(){canceled.current=true;clearTimeout(poll.current);setBusy(false);setJob(null);setToast('Local polling cancelled. A submitted Treblo task may continue and consume credits.');setTimeout(()=>setToast(''),4000)}
 async function loadAudio(source){setBusy(true);try{const b=await decodeAudio(source);setBuffer(b);setAnalysis(analyzeBuffer(b));setMastered(null);setMasterUrl('')}catch(e){setError(`Audio analysis failed: ${e.message}`)}finally{setBusy(false)}}
 async function importAudio(e){const f=e.target.files?.[0];if(!f)return;setAudioUrl(URL.createObjectURL(f));await loadAudio(f);setView('master');setToast('Original imported locally — it has not been uploaded.');setTimeout(()=>setToast(''),2500)}
 async function previewMaster(){if(!buffer)return;setBusy(true);try{const b=await renderMaster(buffer,master);setMastered(b);if(masterUrl)URL.revokeObjectURL(masterUrl);setMasterUrl(URL.createObjectURL(bufferToWav(b)))}catch(e){setError(e.message)}finally{setBusy(false)}}
 function exportWav(){const b=mastered||buffer;if(!b)return;const a=document.createElement('a');a.href=URL.createObjectURL(bufferToWav(b));a.download=`${brief.title.replace(/[^a-z0-9]+/gi,'-').toLowerCase()}-${mastered?'master':'original'}.wav`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
 async function exportEncoded(format){const b=mastered||buffer;if(!b)return;setBusy(true);try{const f=new FormData();f.append('file',bufferToWav(b),'master.wav');const r=await fetch(`/api/export/${format}`,{method:'POST',body:f});if(!r.ok){const j=await r.json();throw new Error(j.error)}const a=document.createElement('a');a.href=URL.createObjectURL(await r.blob());a.download=`${brief.title.replace(/[^a-z0-9]+/gi,'-').toLowerCase()}-master.${format}`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}catch(e){setError(e.message)}finally{setBusy(false)}}
 async function saveProject(id=job?.taskId,url=audioUrl,result=job?.result){if(!id)return;await api(`/api/projects/${id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:brief.title,brief,plan,audioUrl:url,status:'complete',model:result?.model_version||'v3'})}).catch(()=>{})}

 return <div className="app">
  <header><a className="brand"><span><AudioLines/></span><strong>RESONANT</strong><small>AI PRODUCER</small></a><nav><button className={view==='create'?'active':''} onClick={()=>setView('create')}>Create</button><button className={view==='master'?'active':''} onClick={()=>setView('master')}>Mix & master</button></nav><div className="head-actions"><div className={`connection ${config?.verified?'ok':''}`}>{config?.verified?<Zap/>:<CloudOff/>}<span>{config?.verified?`${credits.toLocaleString()} credits`:'Local studio'}</span></div><label className="icon-btn" title="Import audio"><Upload/><input hidden type="file" accept="audio/*" onChange={importAudio}/></label></div></header>
  <main>
   {view==='create'?<>
    <section className="hero"><div><div className="eyebrow"><Sparkles/> PRODUCER-LED GENERATION</div><h1>From first thought<br/>to <em>final master.</em></h1><p>Direct every musical decision. Resonant translates your brief into one production plan, generates across available local models, ranks real signal measurements, then gives you an honest, reversible mastering chain.</p></div><div className="hero-side"><span>ENGINE STATUS</span><strong>{config?.verified?'Treblo Melodia v3 ready':'Generation not connected'}</strong><p>{config?.verified?'Account access and credits verified live.':'Add TREBLO_API_KEY server-side. Editing and mastering stay available.'}</p><a href="https://treblo.com/developers/pricing" target="_blank">100 credits / v3 request <ArrowRight/></a></div></section>
    {!config?.verified&&<div className="notice"><Info/><div><strong>Generation is credit-gated, not “strictly free.”</strong><span>Treblo’s official API currently requires account access and uses 100 credits per v3 request. Free-trial credits require card verification. No generation is started until access and balance are verified. Local analysis, editing and WAV export remain free.</span></div></div>}
    <div className="studio-grid"><section className="panel brief-panel"><div className="panel-title"><div><span>01</span><h2>Creative direction</h2></div><button className="subtle" onClick={()=>setBrief(initial)}><RotateCcw/> Reset</button></div>
      <div className="form-grid"><Field label="Project title" wide><input value={brief.title} onChange={e=>update('title',e.target.value)}/></Field><Field label="Genre"><input value={brief.genre} onChange={e=>update('genre',e.target.value)}/></Field><Field label="Mood"><input value={brief.mood} onChange={e=>update('mood',e.target.value)}/></Field><Field label="Story / meaning" wide><textarea rows="3" value={brief.story} onChange={e=>update('story',e.target.value)}/></Field><Field label="Lyrics" hint="sent verbatim where supported" wide><textarea className="lyrics" rows="10" disabled={brief.instrumental} value={brief.lyrics} onChange={e=>update('lyrics',e.target.value)}/></Field><label className="toggle wide"><input type="checkbox" checked={brief.instrumental} onChange={e=>update('instrumental',e.target.checked)}/><i/><span>Instrumental — do not generate vocals</span></label></div>
      <button className="advanced" onClick={()=>setAdvanced(!advanced)}><SlidersHorizontal/> Detailed production controls <ChevronDown className={advanced?'flip':''}/></button>
      {advanced&&<div className="form-grid advanced-box"><Field label="Instruments" wide><input value={brief.instruments} onChange={e=>update('instruments',e.target.value)}/></Field><Field label="Tempo"><div className="unit"><input type="number" min="40" max="220" value={brief.tempo} onChange={e=>update('tempo',e.target.value)}/><b>BPM</b></div></Field><Field label="Target length"><select value={brief.duration} onChange={e=>update('duration',e.target.value)}><option value="120">2:00</option><option value="180">3:00</option><option value="240">4:00</option></select></Field><Field label="Rhythm / groove" wide><textarea rows="2" value={brief.rhythm} onChange={e=>update('rhythm',e.target.value)}/></Field><Field label="Vocal character" wide><textarea rows="2" value={brief.vocal} onChange={e=>update('vocal',e.target.value)}/></Field><Field label="Melody direction" wide><textarea rows="2" value={brief.melody} onChange={e=>update('melody',e.target.value)}/></Field><Field label="Arrangement" wide><textarea rows="2" value={brief.arrangement} onChange={e=>update('arrangement',e.target.value)}/></Field><Field label="Production preferences" wide><textarea rows="2" value={brief.production} onChange={e=>update('production',e.target.value)}/></Field><Field label="Avoid" wide><input value={brief.negativeTags} onChange={e=>update('negativeTags',e.target.value)}/></Field></div>}
    </section>
    <aside><section className="panel ref-panel"><div className="panel-title"><div><span>02</span><h2>Reference track</h2></div><small>OPTIONAL</small></div><label className={`drop ${reference?'has-file':''}`}><input type="file" accept=".mp3,.m4a,.ogg,.flac,.wav,.aac,.aiff,audio/*" hidden onChange={e=>setReference(e.target.files?.[0]||null)}/>{reference?<><FileAudio/><strong>{reference.name}</strong><small>{(reference.size/1048576).toFixed(1)} MB · ready to upload</small><button onClick={e=>{e.preventDefault();setReference(null)}}><X/></button></>:<><Upload/><strong>Drop a song or choose a file</strong><small>MP3, WAV, FLAC, M4A · max 40 MB</small></>}</label>{reference&&<><Range label="Reference strength" value={brief.referenceStrength} min="1" max="5" step=".1" onChange={v=>update('referenceStrength',v)} suffix="×"/><p className="micro">Higher values follow the source more closely but reduce variety. Only upload audio you have rights to use.</p></>}</section>
     <section className="panel engine-panel"><div className="panel-title"><div><span>FREE / LOCAL</span><h2>Model ensemble</h2></div><button className="subtle" onClick={()=>api('/api/engines').then(setEngines)}><RotateCcw/> Check</button></div><div className="engine-list">{engines.map(e=><div className={`engine-row ${e.available?'online':''}`} key={e.id}><i/><div><strong>{e.name}</strong><small>{e.role}</small></div><b>{e.available?'READY':'OFFLINE'}</b></div>)}</div><label className="toggle research"><input type="checkbox" checked={allowResearch} onChange={e=>setAllowResearch(e.target.checked)}/><i/><span>Include non-commercial research weights</span></label><p className="micro">ACE-Step is eligible by default. YuE2 and MusicGen are excluded unless research mode is enabled because their current weights restrict commercial use.</p><button className="ensemble-btn" disabled={busy||!engines.some(e=>e.available&&(allowResearch||e.commercial))} onClick={generateEnsemble}>{busy?<LoaderCircle className="spin"/>:<Sparkles/>}<span><b>Generate & select best</b><small>{engines.filter(e=>e.available&&(allowResearch||e.commercial)).length} eligible local models</small></span></button>{ensemble&&<div className="candidate-mini">{ensemble.candidates.map(c=><div key={c.engine}><span>{c.name}</span><b>{c.score!==undefined?`${c.score}/100`:c.status}</b></div>)}</div>}</section>
     <section className="panel plan-panel"><div className="panel-title"><div><span>03</span><h2>Producer plan</h2></div><button className="subtle" onClick={buildPlan}>{busy?<LoaderCircle className="spin"/>:<WandSparkles/>} Build</button></div>{plan?<><div className="plan-mode"><Sparkles/><div><small>STRATEGY</small><strong>{plan.mode==='reference'?'Reference-led reimagination':'Text-led full song'}</strong></div></div><div className={`brain-badge ${plan.brain?.used?'on':''}`}><WandSparkles/><span><small>PRODUCER BRAIN</small><b>{plan.brain?.used?`${plan.brain.provider} · ${plan.brain.model}`:'Deterministic local fallback'}</b></span></div><ol>{plan.rationale.map((x,i)=><li key={i}>{x}</li>)}</ol><details><summary>View exact engine prompt</summary><p>{plan.prompt}</p></details></>:<div className="empty-plan"><Music2/><p>Build a plan to preview what the producer director will send to Treblo.</p></div>}</section>
     <button className="generate" disabled={busy||!config?.verified} onClick={generate}><span>{busy?<LoaderCircle className="spin"/>:<Sparkles/>}<b>{busy?'Producing…':'Generate song'}</b></span><small>{config?.verified?'Estimated cost: 100 Treblo credits':'Connect Treblo to enable'}</small></button>
    </aside></div>
   </>:<MasterView/>}
  </main>
  <footer><span>© 2026 Resonant Studio</span><span>Local DSP · Originals preserved</span><a href="https://treblo.com" target="_blank">Powered by Treblo</a></footer>
  {job&&job.status!=='SUCCESS'&&<div className="processing"><div className="process-card"><div className="mark"><AudioLines/></div><div className="eyebrow">RESONANT IS PRODUCING</div><h2>{job.status?.replaceAll('_',' ').toLowerCase()}</h2><p>{job.status==='GENERATING_STREAMING_READY'?'The live stream is ready while the final render completes.':'This is live task status from Treblo — not an estimated animation.'}</p><div className="progress"><i style={{width:`${job.progress||2}%`}}/></div><div className="process-meta"><span>{job.progress||2}%</span><span>{job.taskId?`Task ${job.taskId.slice(0,8)}…`:'Preparing request'}</span></div><button onClick={cancel}><X/> Stop watching</button><small>Stopping local polling cannot cancel a task already accepted by Treblo.</small></div></div>}
  {error&&<div className="error"><Info/><span>{error}</span><button onClick={()=>setError('')}><X/></button></div>}{toast&&<div className="toast"><Check/>{toast}</div>}
 </div>;

 function MasterView(){return <><section className="master-hero"><div><div className="eyebrow"><Activity/> REAL AUDIO ANALYSIS</div><h1>Polish without<br/><em>losing the feeling.</em></h1><p>Analysis runs on decoded audio in your browser. Every processing choice is non-destructive; the original remains untouched.</p></div><label className="import"><Plus/><span><strong>Import a mix</strong><small>Analyze and master locally</small></span><input hidden type="file" accept="audio/*" onChange={importAudio}/></label></section>
  {!buffer?<div className="master-empty"><AudioLines/><h2>No audio loaded yet</h2><p>Generate a song in Create, or import an existing mix. Audio analysis and WAV export run locally and do not require Treblo credits.</p><label className="secondary"><Upload/> Choose audio<input hidden type="file" accept="audio/*" onChange={importAudio}/></label></div>:<div className="master-grid"><section className="panel audio-panel"><div className="panel-title"><div><span>ORIGINAL</span><h2>{brief.title}</h2></div><small>{fmt(buffer.duration)} · {buffer.sampleRate/1000}kHz · {buffer.numberOfChannels===2?'stereo':'mono'}</small></div>{ensemble?.candidates?.some(c=>c.score!==undefined)&&<div className="ranking"><span>ENSEMBLE RANKING</span>{ensemble.candidates.filter(c=>c.localUrl).map((c,i)=><button key={c.engine} className={c.engine===ensemble.bestEngine?'winner':''} onClick={async()=>{setAudioUrl(c.localUrl);await loadAudio(c.localUrl)}}><b>#{i+1} {c.name}</b><em>{c.score}/100 signal score</em></button>)}<small>Ranking uses clipping, peak margin, crest factor and stereo-width measurements—not subjective listening or hit prediction.</small></div>}<Waveform buffer={buffer}/><audio controls src={audioUrl}/><div className="compare"><button className={!mastered?'selected':''}>A · Original</button><button className={mastered?'selected':''} disabled={!mastered}>B · Mastered</button></div>{mastered&&<><Waveform buffer={mastered} color="#ff825c"/><audio controls src={masterUrl}/></>}</section>
   <aside><section className="panel report"><div className="panel-title"><div><span>MEASURED</span><h2>Quality report</h2></div><Activity/></div>{report.map(r=><div className="metric" key={r.label}><div><strong>{r.label}</strong><b>{r.value}</b></div><Meter score={r.score}/><small>{r.note}</small></div>)}<p className="disclaimer"><Info/> These are signal measurements and proxies—not claims about artistic quality, hook appeal, or “hit” potential. No listening model is used.</p></section></aside>
   <section className="panel controls"><div className="panel-title"><div><span>REVERSIBLE CHAIN</span><h2>Mastering controls</h2></div><button className="subtle" onClick={()=>setMaster({low:0,presence:1.2,threshold:-14,ratio:2,gain:-1})}><RotateCcw/> Reset</button></div><div className="control-grid"><Range label="Low shelf" value={master.low} min="-6" max="6" step=".1" suffix=" dB" onChange={v=>setMaster(x=>({...x,low:v}))}/><Range label="Presence" value={master.presence} min="-6" max="6" step=".1" suffix=" dB" onChange={v=>setMaster(x=>({...x,presence:v}))}/><Range label="Comp threshold" value={master.threshold} min="-30" max="-4" suffix=" dB" onChange={v=>setMaster(x=>({...x,threshold:v}))}/><Range label="Comp ratio" value={master.ratio} min="1" max="6" step=".1" suffix=":1" onChange={v=>setMaster(x=>({...x,ratio:v}))}/><Range label="Output trim" value={master.gain} min="-8" max="3" step=".1" suffix=" dB" onChange={v=>setMaster(x=>({...x,gain:v}))}/></div><div className="master-actions"><button className="secondary" onClick={previewMaster} disabled={busy}>{busy?<LoaderCircle className="spin"/>:<Play/>} Render comparison</button><button className="primary" onClick={exportWav}><Download/> WAV</button>{config?.ffmpeg&&<><button className="primary" onClick={()=>exportEncoded('flac')}><Download/> FLAC</button><button className="primary" onClick={()=>exportEncoded('mp3')}><Download/> MP3</button></>}</div><p className="micro">Browser DSP uses biquad EQ, dynamics compression and output trim. WAV is always available; lossless FLAC and 320 kbps MP3 appear when the free FFmpeg server encoder is installed. Demucs is intentionally not enabled without verified compute.</p></section></div>}
 </>}
}

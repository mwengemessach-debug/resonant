import test from 'node:test';import assert from 'node:assert/strict';import{buildProductionPlan,makeTrebloPayload,statusProgress}from'../server/producer.js';
test('builds bounded, lyric-preserving plan',()=>{const p=buildProductionPlan({genre:'Afrobeats',tempo:999,duration:181,lyrics:'Keep these words'});assert.equal(p.bpm,220);assert.equal(p.lyrics,'Keep these words');assert.deepEqual(p.length_range,[150,210]);assert.match(p.prompt,/Afrobeats/)});
test('reference payload uses official v3 controls',()=>{const brief={referenceUploadId:'upload-id',referenceStrength:2.5,referenceStart:0,referenceEnd:90};const p=buildProductionPlan(brief),body=makeTrebloPayload(p,brief);assert.equal(p.mode,'reference');assert.equal(body.audio_upload_id,'upload-id');assert.equal(body.reference_scale,2.5);assert.equal(body.reference_crop_end,90)});
test('status progress is monotonic at endpoints',()=>{assert.equal(statusProgress('RECEIVED'),4);assert.equal(statusProgress('SUCCESS'),100);assert.equal(statusProgress('FAILURE'),100)});
